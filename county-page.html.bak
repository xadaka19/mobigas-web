m transition-colors">Gas prices Kenya</a></li><li><a href="/lpg-cylinder-sizes-kenya" class="text-gray-400 hover:text-white text-sm transition-colors">Cylinder sizes</a></li><li><a href="/cooking-gas-safety-kenya" class="text-gray-400 hover:text-white text-sm transition-colors">Gas safety tips</a></li><li><a href="/is-mobigas-safe" class="text-gray-400 hover:text-white text-sm transition-colors">Is MobiGas safe?</a></li><li><a href="/areas" class="text-gray-400 hover:text-white text-sm transition-colors">Coverage areas</a></li><li><a href="/mobigas-referral" class="text-gray-400 hover:text-white text-sm transition-colors">Refer a friend</a></li></ul></div><div><h4 class="text-white font-semibold mb-4">Top Cities</h4><ul class="space-y-3"><li><a href="/gas-delivery-nairobi" class="text-gray-400 hover:text-white text-sm transition-colors">Gas delivery Nairobi</a></li><li><a href="/gas-delivery-mombasa" class="text-gray-400 hover:text-white text-sm transition-colors">Gas delivery Mombasa</a></li><li><a href="/gas-delivery-kisumu" class="text-gray-400 hover:text-white text-sm transition-colors">Gas delivery Kisumu</a></li><li><a href="/gas-delivery-nakuru" class="text-gray-400 hover:text-white text-sm transition-colors">Gas delivery Nakuru</a></li><li><a href="/gas-delivery-eldoret" class="text-gray-400 hover:text-white text-sm transition-colors">Gas delivery Eldoret</a></li><li><a href="/gas-delivery-kiambu" class="text-gray-400 hover:text-white text-sm transition-colors">Gas delivery Kiambu</a></li><li><a href="/gas-delivery-thika" class="text-gray-400 hover:text-white text-sm transition-colors">Gas delivery Thika</a></li></ul></div><div><h4 class="text-white font-semibold mb-4">Legal</h4><ul class="space-y-3"><li><a href="/terms" class="text-gray-400 hover:text-white text-sm transition-colors">Terms of Service</a></li><li><a href="/privacy" class="text-gray-400 hover:text-white text-sm transition-colors">Privacy Policy</a></li><li><a href="/data-protection" class="te